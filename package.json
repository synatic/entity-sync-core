{
  "name": "@synatic/entity-sync-core",
  "version": "1.0.0",
  "description": "Core Synatic entity sync logic — plan, preview, and execute against the entity-sync API",
  "type": "module",
  "main": "index.js",
  "bin": {
    "entity-sync": "cli.js"
  },
  "files": [
    "lib/**/*",
    "index.js",
    "cli.js"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "lint-errors": "eslint . --quiet",
    "test": "mocha --reporter spec --bail --check-leaks test/",
    "test-ci": "nyc --reporter text-summary mocha -- --reporter spec --check-leaks test/",
    "test-cov": "nyc --reporter lcov --reporter text mocha -- --reporter dot --check-leaks test/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/synatic/entity-sync-core.git"
  },
  "keywords": [
    "synatic",
    "entity-sync"
  ],
  "author": {
    "name": "Synatic Inc",
    "url": "https://synatic.com"
  },
  "contributors": [
    {
      "name": "Martin Naude"
    },
    {
      "name": "Thiren Bunsee"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/synatic/entity-sync-core/issues"
  },
  "homepage": "https://github.com/synatic/entity-sync-core#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "got": "^14.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^10.6.0",
    "globals": "^15.14.0",
    "mocha": "^11.7.5",
    "nyc": "^18.0.0"
  }
}
